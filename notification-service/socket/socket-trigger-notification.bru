meta {
  name: "Trigger Socket Notification"
  type: http
  seq: 4
}

post {
  url: {{notificationServiceUrl}}/socket/notifications/send
  body: json
  auth: inherit
}

body:json {
  {
    "event": "notification:new",
    "room": "vendor:vendor_123",
    "data": {
      "title": "Test WebSocket Notification",
      "message": "This notification was sent via WebSocket to vendor room",
      "category": "TEST",
      "subCategory": "WEBSOCKET_TEST",
      "priority": "normal",
      "timestamp": "{{currentTimestamp}}"
    }
  }
}