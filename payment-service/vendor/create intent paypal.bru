meta {
  name: Create Payment Intent - PayPal
  type: http
  seq: 2
}

post {
  url: {{paymentServiceUrl}}/api/v1/payment/vendor/intent
  body: json
  auth: inherit
}

body:json {
  {
    "amount": 75,
    "currency": "usd",
    "paymentMethod": "paypal",
    "metadata": {
      "package": "Pro Pack",
      "coins": 75
    }
  }
}

vars:post-response {
  paypalPaymentIntentId: res.body.data.paymentIntent.id
  paypalPaymentRecordId: res.body.data.paymentRecordId
  paypalCoinsToReceive: res.body.data.coinsToReceive
  paypalSessionId: res.body.data.sessionId
}

assert {
  status: 201
  jsonpath: $.success {
    "eq": true
  }
  jsonpath: $.data.paymentIntent.id {
    "exists": true
  }
  jsonpath: $.data.paymentRecordId {
    "exists": true
  }
  jsonpath: $.data.coinsToReceive {
    "eq": 75
  }
  jsonpath: $.data.sessionId {
    "exists": true
  }
  jsonpath: $.message {
    "contains": "created successfully"
  }
}