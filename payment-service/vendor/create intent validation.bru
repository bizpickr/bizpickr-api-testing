assert {
  status: 400
  jsonpath: $.success {
    "eq": false
  }
  jsonpath: $.error.code {
    "eq": "VALIDATION_ERROR"
  }
}

### Test 3: Invalid Payment Method
post {
  url: {{paymentServiceUrl}}/api/v1/payment/vendor/intent
  body: json
