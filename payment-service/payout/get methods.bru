meta {
  name: Get Payout Methods
  type: http
  seq: 1
}

get {
  url: {{paymentServiceUrl}}/api/v1/payment/payout/methods
  body: none
  auth: inherit
}

assert {
  status: 200
  jsonpath: $.methods {
    "isArray": true
  }
  jsonpath: $.methods {
    "contains": "paypal"
  }
  jsonpath: $.methods {
    "contains": "stripe_connect"
  }
  jsonpath: $.correlationId {
    "exists": true
  }
}