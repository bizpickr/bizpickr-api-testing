meta {
  name: Get Refund Status
  type: http
  seq: 2
}

get {
  url: {{paymentServiceUrl}}/api/v1/payment/refund/status/{{refundId}}
  body: none
  auth: inherit
}

assert {
  status: 501
  jsonpath: $.error {
    "contains": "Not implemented"
  }
  jsonpath: $.correlationId {
    "exists": true
  }
}