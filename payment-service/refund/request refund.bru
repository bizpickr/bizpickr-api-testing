meta {
  name: Request Refund
  type: http
  seq: 1
}

post {
  url: {{paymentServiceUrl}}/api/v1/payment/refund/request
  body: json
  auth: inherit
}

body:json {
  {
    "originalTransactionId": "{{paymentRecordId}}",
    "refundAmount": 50,
    "currency": "usd",
    "refundReason": "customer_request",
    "refundDescription": "Customer requested refund"
  }
}

assert {
  status: 501
  jsonpath: $.error {
    "contains": "Not implemented"
  }
  jsonpath: $.correlationId {
    "exists": true
  }
}
