meta {
  name: PayPal Webhook - Payment Success
  type: http
  seq: 2
}

post {
  url: {{paymentServiceUrl}}/api/v1/webhook/paypal
  body: json
  auth: none
  headers {
    paypal-transmission-id: test_transmission_id
    paypal-transmission-time: {{$timestamp}}
    paypal-transmission-sig: test_signature
  }
}

body:json {
  {
    "id": "WH-TEST-{{$timestamp}}",
    "event_type": "PAYMENT.CAPTURE.COMPLETED",
    "create_time": "2024-01-01T00:00:00Z",
    "resource_type": "capture",
    "resource": {
      "id": "{{paypalPaymentIntentId}}",
      "status": "COMPLETED",
      "amount": {
        "currency_code": "USD",
        "value": "75.00"
      },
      "custom_id": "{{paypalSessionId}}"
    }
  }
}

assert {
  status: 200
  jsonpath: $.received {
    "eq": true
  }
  jsonpath: $.status {
    "in": ["queued_for_processing", "already_queued"]
  }
  jsonpath: $.correlationId {
    "exists": true
  }
}
