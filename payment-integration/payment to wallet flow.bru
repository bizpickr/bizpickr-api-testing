meta {
  name: Payment to Wallet Integration Test
  type: http
  seq: 1
}

### Step 1: Create Payment Intent
post {
  url: {{paymentServiceUrl}}/api/v1/payment/vendor/intent
  body: json
  auth: inherit
}

body:json {
  {
    "amount": 10,
    "currency": "USD",
    "paymentMethod": "stripe",
    "metadata": {
      "test": "integration_test",
      "expected_coins": 10
    }
  }
}

assert {
  status: 200
  jsonpath: $.success {
    "eq": true
  }
  jsonpath: $.data.paymentIntent.id {
    "exists": true
  }
  jsonpath: $.data.coinsToReceive {
    "eq": 10
  }
}

vars {
  "paymentIntentId": $.data.paymentIntent.id
  "paymentRecordId": $.data.paymentRecordId
  "sessionId": $.data.sessionId
  "expectedCoins": $.data.coinsToReceive
}

### Step 2: Check Wallet Balance Before Payment
get {
  url: {{vendorServiceUrl}}/wallet
  body: none
  auth: inherit
}

assert {
  status: 200
  jsonpath: $.success {
    "eq": true
  }
  jsonpath: $.data.balance {
    "gte": 0
  }
}

vars {
  "balanceBefore": $.data.balance
  "totalCreditsBefore": $.data.totalCredits
}

### Step 3: Simulate Payment Success (Webhook)
# Note: In real testing, you would trigger actual webhook from Stripe/PayPal
# For testing purposes, we'll check if the inbox/outbox system is working
get {
  url: {{paymentServiceUrl}}/health
  body: none
  auth: none
}

assert {
  status: 200
  jsonpath: $.status {
    "eq": "OK"
  }
}

### Step 4: Check Wallet Balance After Payment (Manual Check)
# In real scenario, wait for webhook processing
# For now, this shows the expected behavior
get {
  url: {{vendorServiceUrl}}/wallet
  body: none
  auth: inherit
}

assert {
  status: 200
  jsonpath: $.success {
    "eq": true
  }
}

# Expected: balance should increase by expectedCoins
# totalCredits should increase by expectedCoins
# Note: This assertion would pass only after webhook processing
jsonpath: $.data.balance {
  "gte": {{balanceBefore}}
}

jsonpath: $.data.totalCredits {
  "gte": {{totalCreditsBefore}}
}