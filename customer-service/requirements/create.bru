meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{customerServiceUrl}}/requirements
  body: json
  auth: inherit
}

body:json {
  {
    "industryId": "{{industryId}}",
    "selectedMappings": [
      {
        "id": "{{mappingId}}",
        "t": "Medical Website"
      }
    ],
    "budgetType": "fixed",
    "budget": 5000,
    "preferredCountry": "IN",
    "preferredCity": "Mumbai",
    "vendorType": "company",
    "noOfVendors": 3,
    "estimatedTime": "ASAP"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
