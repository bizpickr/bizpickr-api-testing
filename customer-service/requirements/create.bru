meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{customerServiceUrl}}/requirements
  body: json
  auth: inherit
}

body:json {
  {
    "industryCode": "{{industryCode}}",
    "industryName": "Healthcare & Medical",
    "selectedMappings": [
      {
        "id": "{{mappingId}}",
        "e": "🌐",
        "t": "Medical Website",
        "d": "Professional website for clinic or hospital",
        "serviceId": "{{serviceId}}",
        "serviceCode": "website_development"
      }
    ],
    "budgetType": "fixed",
    "budget": 5000,
    "preferredCountry": "IN",
    "preferredCity": "Mumbai",
    "vendorType": "company",
    "noOfVendors": 3,
    "estimatedTime": "ASAP"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
