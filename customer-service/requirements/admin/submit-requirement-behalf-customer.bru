meta {
  name: submit/requirement/behalf/customer
  type: http
  seq: 2
}

post {
  url: {{customerServiceUrl}}/requirements/admin/:customerId/submit-requirement
  body: json
  auth: inherit
}

params:path {
  customerId: d175544d-8645-41fe-83d2-7bc9cd7ccec6
}

body:json {
  {
    "industryId": "{{industryId}}",
    "selectedMappings": [
      {
        "id": "{{mappingId}}",
        "t": "Medical Website"
      }
    ],
    "budgetType": "hourly",
    "budget": 100,
    "preferredCountry": "GB",
    "preferredCity": "Bristol",
    "vendorType": "freelancer",
    "noOfVendors": 3,
    "estimatedTime": "ASAP"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
