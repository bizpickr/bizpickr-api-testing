meta {
  name: Send Message
  type: http
  seq: 1
}

post {
  url: {{chatServiceUrl}}/channels/{{channelId}}/messages
  body: json
  auth: inherit
}

body:json {
  {
    "content": "Hello! I'm interested in your project. Can we discuss the requirements?",
    "senderId": "vendor_67890",
    "senderType": "vendor",
    "metadata": {
      "source": "app",
      "ipAddress": "127.0.0.1"
    }
  }
}
